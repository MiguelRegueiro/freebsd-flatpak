@@ -0,0 +1,112 @@
+/* Linux xattr API compatibility for the private bare-user-only repository.
+ *
+ * Flatpak's bare-user-only mode deliberately stores canonical uid/gid/mode
+ * and no xattrs.  Its pull verification rejects content outside that model,
+ * and user-mode checkout does not restore xattrs.  Keep the unsupported API
+ * explicit rather than adding an extattr(2) translation that this build must
+ * never use.
+ */
+#pragma once
+
+#ifdef __FreeBSD__
+
+#include <errno.h>
+#include <sys/types.h>
+
+#ifndef ENODATA
+#define ENODATA ENOATTR
+#endif
+#ifndef XATTR_CREATE
+#define XATTR_CREATE 0x1
+#endif
+#ifndef XATTR_REPLACE
+#define XATTR_REPLACE 0x2
+#endif
+
+static inline ssize_t
+fgetxattr (int fd, const char *name, void *value, size_t size)
+{
+  (void)fd;
+  (void)name;
+  (void)value;
+  (void)size;
+  errno = ENOTSUP;
+  return -1;
+}
+
+static inline ssize_t
+lgetxattr (const char *path, const char *name, void *value, size_t size)
+{
+  (void)path;
+  (void)name;
+  (void)value;
+  (void)size;
+  errno = ENOTSUP;
+  return -1;
+}
+
+static inline int
+fsetxattr (int fd, const char *name, const void *value, size_t size, int flags)
+{
+  (void)fd;
+  (void)name;
+  (void)value;
+  (void)size;
+  (void)flags;
+  errno = ENOTSUP;
+  return -1;
+}
+
+static inline int
+lsetxattr (const char *path, const char *name, const void *value, size_t size, int flags)
+{
+  (void)path;
+  (void)name;
+  (void)value;
+  (void)size;
+  (void)flags;
+  errno = ENOTSUP;
+  return -1;
+}
+
+static inline int
+fremovexattr (int fd, const char *name)
+{
+  (void)fd;
+  (void)name;
+  errno = ENOTSUP;
+  return -1;
+}
+
+static inline int
+lremovexattr (const char *path, const char *name)
+{
+  (void)path;
+  (void)name;
+  errno = ENOTSUP;
+  return -1;
+}
+
+static inline ssize_t
+flistxattr (int fd, char *list, size_t size)
+{
+  (void)fd;
+  (void)list;
+  (void)size;
+  errno = ENOTSUP;
+  return -1;
+}
+
+static inline ssize_t
+llistxattr (const char *path, char *list, size_t size)
+{
+  (void)path;
+  (void)list;
+  (void)size;
+  errno = ENOTSUP;
+  return -1;
+}
+
+#else
+#include_next <sys/xattr.h>
+#endif
