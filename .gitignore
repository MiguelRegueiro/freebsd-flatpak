/target/
/bin/*
!/bin/.gitkeep

# Downloaded Flatpak metadata, OSTree objects, and extracted runtimes/apps.
/downloads/*
!/downloads/.gitkeep
/runtime/*
!/runtime/.gitkeep
/state/*
!/state/.gitkeep
/exports/*
!/exports/.gitkeep

# Temporary mount/chroot scratch space.
/mounts/*
!/mounts/.gitkeep

*.tmp
*.log
